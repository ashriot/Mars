[gd_resource type="Resource" script_class="Action" format=3 uid="uid://bm4jlai25snkq"]

[ext_resource type="Script" uid="uid://ctjat8xfpajqc" path="res://src/scripts/action_effects/action_effect.gd" id="1_effect"]
[ext_resource type="Script" uid="uid://dm08rhkg3bai3" path="res://src/scripts/data/action.gd" id="2_action"]
[ext_resource type="Texture2D" uid="uid://cbmlvl7d52lei" path="res://assets/graphics/icons/skills/lightning-shadow.png" id="3_icon"]
[ext_resource type="Script" uid="uid://df30dm288ne1d" path="res://src/scripts/conditions/condition.gd" id="4_condition"]
[ext_resource type="Script" uid="uid://cdugd6pnm6py" path="res://src/scripts/conditions/trigger.gd" id="5_trigger"]
