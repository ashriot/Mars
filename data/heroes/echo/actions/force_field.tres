[sub_resource type="Resource" id="Resource_suppress_debuff"]
script = ExtResource("4_condition")
condition_name = "Suppress"
icon = ExtResource("3_icon")
description = "This enemy deals 25% less damage until Echo Shifts."
condition_type = 1
damage_dealt_scalar = -0.25
metadata/_custom_type_script = "uid://df30dm288ne1d"

[sub_resource type="Resource" id="Resource_apply_suppress"]
script = ExtResource("6_apply")
condition = SubResource("Resource_suppress_debuff")
metadata/_custom_type_script = "uid://dggojfw8tmpnk"

[sub_resource type="Resource" id="Resource_remove_suppress"]
script = ExtResource("7_remove")
condition_name = "Suppress"
target_type = 1
metadata/_custom_type_script = "uid://ddjg3oka0dtvg"

[sub_resource type="Resource" id="Resource_cleanup_trigger"]
script = ExtResource("5_trigger")
trigger_type = 12
effects_to_run = Array[ExtResource("1_effect")]([SubResource("Resource_remove_suppress")])
metadata/_custom_type_script = "uid://cdugd6pnm6py"

[sub_resource type="Resource" id="Resource_suppress_cleanup"]
script = ExtResource("4_condition")
condition_name = "Suppress Cleanup"
description = "Removes Suppress from all enemies when Echo next Shifts."
is_passive = true
triggers = Array[ExtResource("5_trigger")]([SubResource("Resource_cleanup_trigger")])
remove_on_triggers = Array[int]([12])
metadata/_custom_type_script = "uid://df30dm288ne1d"

[sub_resource type="Resource" id="Resource_apply_cleanup"]
script = ExtResource("6_apply")
condition = SubResource("Resource_suppress_cleanup")
target_type = 4
metadata/_custom_type_script = "uid://dggojfw8tmpnk"

[resource]
script = ExtResource("2_action")
action_name = "Suppress"
icon = ExtResource("3_icon")
description = "Shift.[p]Reduce one enemy's damage dealt by 25% until Echo Shifts again."
is_shift_action = true
effects = Array[ExtResource("1_effect")]([SubResource("Resource_apply_suppress"), SubResource("Resource_apply_cleanup")])
metadata/_custom_type_script = "uid://dm08rhkg3bai3"
